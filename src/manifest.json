{
  "manifest_version": 2,
  "name": "Bypass Proofpoint Redirect",
  "version": "1.0.1",
  "description": "Bypass Proofpoint URL Defense redirection",
  "background": {
    "scripts": ["background.js"]
  },
  "browser_specific_settings": {
    "gecko": {
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  },
  "permissions": [
    "webRequest",
    "webRequestBlocking",
    "https://urldefense.com/v1/url?*",
    "https://urldefense.com/v2/url?*",
    "https://urldefense.com/v3/*",
    "https://urldefense.proofpoint.com/v1/url?*",
    "https://urldefense.proofpoint.com/v2/url?*",
    "https://urldefense.proofpoint.com/v3/*"
  ]
}
